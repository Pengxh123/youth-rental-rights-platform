/* pages/verify-result/verify-result.wxss */
page {
  background-color: #f5f5f5;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* List view style */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.records-list {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.record-item.warning {
  border-left: 8rpx solid #ff4d4f;
}

.record-item.success {
  border-left: 8rpx solid #52c41a;
}

.record-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.record-icon {
  font-size: 48rpx;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-status {
  font-size: 24rpx;
  color: #999;
}

.record-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
}

.price-label {
  color: #666;
}

.price-value {
  color: #333;
  font-weight: bold;
}

.price-value.overpriced {
  color: #ff4d4f;
}

/* Empty state style */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.new-btn {
  width: 280rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

/* Detail view style */
.result-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.result-card.warning {
  border-top: 8rpx solid #ff4d4f;
}

.result-card.success {
  border-top: 8rpx solid #52c41a;
}

.result-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 30rpx;
}

.result-icon {
  font-size: 56rpx;
}

.result-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.result-time {
  font-size: 24rpx;
  color: #999;
}

.result-details {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.detail-item.highlight {
  background: rgba(255, 77, 79, 0.05);
  margin: 0 -20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
}

.detail-label {
  font-size: 28rpx;
  color: #666;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.detail-value.overpriced {
  color: #ff4d4f;
}

.text-danger {
  color: #ff4d4f;
}

/* Negotiation script style */
.negotiation-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 0 30rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.card-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.copy-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

/* Action button style */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx;
  margin-top: 30rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.secondary {
  background: #f0f0f0;
  color: #333;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.action-btn.danger {
  background: #fff1f0;
  color: #ff4d4f;
}
