<!-- Profile Page -->
<view class="page-container">
  <!-- User Info Card -->
  <view class="user-card">
    <view class="user-info-header">
      <view class="user-avatar-placeholder" bindtap="editAvatar" wx:if="{{!userInfo.avatar}}">
        <text class="avatar-placeholder-icon">👤</text>
      </view>
      <image class="user-avatar" src="{{userInfo.avatar}}" mode="aspectFill" bindtap="editAvatar" wx:else />
      <view class="user-basic">
        <text class="user-name">{{userInfo.nickName || 'Tap to Login'}}</text>
        <text class="user-desc">{{userInfo.realName ? 'Verified' : 'Not Verified'}} · {{userInfo.mobile ? 'Phone Linked' : 'Not Linked'}}</text>
      </view>
      <view class="edit-btn" bindtap="editProfile" wx:if="{{userInfo.nickName}}">
        <text>Edit</text>
      </view>
      <view class="login-btn" bindtap="login" wx:if="{{!userInfo.nickName}}">
        <text>Login</text>
      </view>
    </view>

    <!-- User Stats -->
    <view class="user-stats">
      <view class="stat-item" bindtap="viewRecords" data-type="rights">
        <text class="stat-value">{{stats.rightsCount}}</text>
        <text class="stat-label">Rights Cases</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="viewRecords" data-type="verify">
        <text class="stat-value">{{stats.verifyCount}}</text>
        <text class="stat-label">Verifications</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="viewRecords" data-type="topics">
        <text class="stat-value">{{stats.topicCount}}</text>
        <text class="stat-label">Topics</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="viewRecords" data-type="favorites">
        <text class="stat-value">{{stats.favoriteCount}}</text>
        <text class="stat-label">Favorites</text>
      </view>
    </view>
  </view>

  <!-- Message Notifications -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">Notifications</text>
      <text class="unread-badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</text>
    </view>
    <view class="message-list">
      <view class="message-item" bindtap="viewMessage" data-type="rights">
        <view class="message-icon">⚖️</view>
        <view class="message-content">
          <text class="message-title">Rights Case Updates</text>
          <text class="message-desc">Track the progress of your cases</text>
        </view>
        <text class="message-arrow">›</text>
      </view>
      <view class="message-item" bindtap="viewMessage" data-type="interactive">
        <view class="message-icon">💬</view>
        <view class="message-content">
          <text class="message-title">Interactive Messages</text>
          <text class="message-desc">Comments and replies on your posts</text>
        </view>
        <text class="message-arrow">›</text>
      </view>
      <view class="message-item" bindtap="viewMessage" data-type="system">
        <view class="message-icon">🔔</view>
        <view class="message-content">
          <text class="message-title">System Notifications</text>
          <text class="message-desc">Platform announcements and updates</text>
        </view>
        <text class="message-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- Quick Actions -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">Quick Actions</text>
    </view>
    <view class="action-list">
      <view class="action-item" bindtap="navigateTo" data-page="/pages/my-favorites/my-favorites">
        <view class="action-icon">⭐</view>
        <text class="action-text">My Favorites</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-item" bindtap="navigateTo" data-page="/pages/my-topics/my-topics">
        <view class="action-icon">💬</view>
        <text class="action-text">My Topics</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-item" bindtap="navigateTo" data-page="/pages/rights-records/rights-records">
        <view class="action-icon">📋</view>
        <text class="action-text">Rights Records</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-item" bindtap="navigateTo" data-page="/pages/verify-result/verify-result">
        <view class="action-icon">📊</view>
        <text class="action-text">Verification Reports</text>
        <text class="action-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- Settings -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">Settings</text>
    </view>
    <view class="action-list">
      <view class="action-item">
        <view class="action-icon">🔔</view>
        <text class="action-text">Push Notifications</text>
        <switch class="setting-switch" checked="{{settings.message}}" bindchange="toggleSetting" data-setting="message"/>
      </view>
      <view class="action-item">
        <view class="action-icon">🔒</view>
        <text class="action-text">Anonymous Posting</text>
        <switch class="setting-switch" checked="{{settings.anonymous}}" bindchange="toggleSetting" data-setting="anonymous"/>
      </view>
      <view class="action-item" bindtap="clearCache">
        <view class="action-icon">🧹</view>
        <text class="action-text">Clear Cache</text>
        <text class="action-value">{{cacheSize}}</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-item" bindtap="navigateTo" data-page="/pages/help-center/help-center">
        <view class="action-icon">❓</view>
        <text class="action-text">Help Center</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-item" bindtap="navigateTo" data-page="/pages/feedback/feedback">
        <view class="action-icon">💭</view>
        <text class="action-text">Feedback</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-item" bindtap="navigateTo" data-page="/pages/about/about">
        <view class="action-icon">ℹ️</view>
        <text class="action-text">About</text>
        <text class="action-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- Logout Button -->
  <view class="logout-section" wx:if="{{userInfo.nickName}}">
    <button class="logout-btn" bindtap="logout">Logout</button>
  </view>

  <!-- Version Info -->
  <view class="version-info">
    <text class="version-text">Version v1.0.0</text>
  </view>

  <!-- Bottom Navigation -->
  <bottom-nav currentPage="profile"></bottom-nav>
</view>
