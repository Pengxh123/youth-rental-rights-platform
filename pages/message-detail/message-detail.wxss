/* Action buttons */
.action-buttons {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 30rpx;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.action-btn::after {
  border: none;
}
