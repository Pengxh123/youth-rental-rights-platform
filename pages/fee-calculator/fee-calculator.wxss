/* pages/fee-calculator/fee-calculator.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 30rpx;
}

/* City picker */
.city-selector {
  background: #fff;
  border-radius: 20rpx;
  margin: 30rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.city-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.picker-view {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 48rpx;
  color: #1890ff;
  font-weight: 300;
}

/* Fee standard tips */
.rates-hint {
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 24rpx;
}

.hint-title {
  display: block;
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.calculator-form {
  background: #fff;
  border-radius: 20rpx;
  margin: 30rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: #1890ff;
  margin-top: 8rpx;
}

.calculate-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 20rpx;
}

/* Calculation result */
.result-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.result-header {
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.period-tabs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.period-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: #f5f7fa;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}

.period-tab.active {
  background: #1890ff;
  color: #fff;
}

.total-display {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.total-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
}

.total-amount {
  display: block;
  font-size: 56rpx;
  color: #fff;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.total-note {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.breakdown {
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.breakdown-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.breakdown-item:last-child,
.breakdown-item.total {
  border-bottom: none;
}

.breakdown-item.total {
  padding-top: 20rpx;
  margin-top: 10rpx;
  border-top: 2rpx solid #1890ff;
}

.breakdown-label {
  font-size: 28rpx;
  color: #666;
}

.breakdown-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.breakdown-item.total .breakdown-value {
  font-size: 36rpx;
  color: #1890ff;
}
