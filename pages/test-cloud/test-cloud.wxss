/* pages/test-cloud/test-cloud.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 40rpx;
}

.header {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 60rpx;
}

.test-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.test-btn {
  background: linear-gradient(135deg, #FFC107 0%, #FFB300 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  border: none;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 193, 7, 0.3);
}

.test-btn.secondary {
  background: linear-gradient(135deg, #4ECDC4 0%, #44A08D 100%);
  box-shadow: 0 4rpx 12rpx rgba(78, 205, 196, 0.3);
}

.test-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.result-box {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.result-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}

.result-text {
  font-size: 24rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  width: 180rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.info-value.success {
  color: #4CAF50;
}

.info-value.error {
  color: #F44336;
}
