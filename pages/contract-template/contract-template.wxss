/* pages/contract-template/contract-template.wxss */
/* Intro card */
.intro-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  margin: 30rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
}

.intro-title {
  display: block;
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.intro-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 30rpx;
  line-height: 1.6;
}

.intro-features {
  display: flex;
  gap: 30rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.feature-icon {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
}

.feature-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* Section title */
.section-title {
  display: block;
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

/* Key points card */
.points-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.point-item {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  overflow: hidden;
}

.point-item:last-child {
  border-bottom: none;
}

.point-item.warning {
  background: #fff7e6;
  margin: 0 -30rpx;
  padding: 24rpx 30rpx;
}

.point-icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #f5f7fa;
  border-radius: 50%;
  font-size: 24rpx;
  flex-shrink: 0;
}

.point-item.warning .point-icon {
  background: #fff7e6;
}

.point-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.point-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.point-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* Contract preview */
.contract-preview {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.contract-header {
  text-align: center;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #1890ff;
  margin-bottom: 30rpx;
}

.contract-title {
  font-size: 36rpx;
  color: #333;
  font-weight: 700;
}

.contract-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.contract-section {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.8;
}

.contract-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  text-indent: 2em;
}

.contract-text.highlight {
  color: #faad14;
  font-weight: 500;
  background: #fffbe6;
  padding: 4rpx 8rpx;
}

/* Action buttons */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx 30rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.action-btn.preview {
  background: #f5f7fa;
  color: #333;
}

.action-btn.download {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
}

/* Tips card */
.tips-card {
  background: #e6f7ff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.tips-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 12rpx;
}
