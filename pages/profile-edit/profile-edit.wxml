<view class="profile-edit-container">
  <!-- Avatar Edit -->
  <view class="avatar-section">
    <view class="avatar-wrapper" bindtap="chooseAvatar">
      <image 
        class="avatar" 
        src="{{userInfo.avatar || 'https://via.placeholder.com/120'}}" 
        mode="aspectFill"
      />
      <view class="avatar-edit">
        <text>Change Avatar</text>
      </view>
    </view>
  </view>

  <!-- Basic Info -->
  <view class="info-section">
    <!-- Nickname -->
    <view class="info-item">
      <view class="info-label">Nickname</view>
      <view class="info-value">
        <input 
          wx:if="{{editing.nickName}}" 
          class="info-input" 
          value="{{userInfo.nickName}}" 
          bindinput="onNickNameChange" 
          bindblur="onNickNameBlur" 
          focus
        />
        <view 
          wx:else 
          class="info-text" 
          bindtap="onNickNameTap"
        >
          {{userInfo.nickName || 'Not Set'}}
          <text class="edit-icon">✏️</text>
        </view>
      </view>
    </view>

    <!-- Real Name Verification -->
    <view class="info-item">
      <view class="info-label">Real Name Verification</view>
      <view class="info-value">
        <input 
          wx:if="{{editing.realName}}" 
          class="info-input" 
          value="{{userInfo.realName}}" 
          bindinput="onRealNameChange" 
          bindblur="onRealNameBlur" 
          focus
        />
        <view wx:else>
          <view wx:if="{{userInfo.realName}}" class="info-text">
            {{userInfo.realName}}
            <text class="edit-icon">✏️</text>
          </view>
          <view wx:else class="info-action" bindtap="bindRealName">
            <text class="action-text">Not Verified, Tap to Verify</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Phone Number -->
    <view class="info-item">
      <view class="info-label">Phone Number</view>
      <view class="info-value">
        <input 
          wx:if="{{editing.mobile}}" 
          class="info-input" 
          value="{{userInfo.mobile}}" 
          bindinput="onMobileChange" 
          bindblur="onMobileBlur" 
          focus
        />
        <view wx:else>
          <view wx:if="{{userInfo.mobile}}" class="info-text">
            {{userInfo.mobile}}
            <text class="edit-icon">✏️</text>
          </view>
          <view wx:else class="info-action" bindtap="bindMobile">
            <text class="action-text">Not Bound, Tap to Bind</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Unbind Operations -->
  <view wx:if="{{userInfo.realName || userInfo.mobile}}" class="unbind-section">
    <view wx:if="{{userInfo.realName}}" class="unbind-item" bindtap="unbindRealName">
      <text>Unbind Real Name Verification</text>
    </view>
    <view wx:if="{{userInfo.mobile}}" class="unbind-item" bindtap="unbindMobile">
      <text>Unbind Phone Number</text>
    </view>
  </view>

  <!-- Action Buttons -->
  <view class="button-section">
    <view class="cancel-btn" bindtap="onCancel">
      <text>Cancel</text>
    </view>
    <view class="submit-btn" bindtap="onSubmit" wx:if="{{!isSubmitting}}">
      <text>Save</text>
    </view>
    <view class="submit-btn loading" wx:else>
      <text>Saving...</text>
    </view>
  </view>

  <!-- Tips -->
  <view class="tip-section">
    <text class="tip-text">Tip: Real name verification and phone binding can improve account security</text>
  </view>
</view>
