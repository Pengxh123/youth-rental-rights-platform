.profile-edit-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx 20rpx;
}

.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 3rpx solid #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  padding: 15rpx 0;
  border-radius: 0 0 100rpx 100rpx;
}

.info-section {
  background-color: #fff;
  border-radius: 15rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  width: 150rpx;
}

.info-value {
  flex: 1;
  text-align: right;
}

.info-input {
  font-size: 30rpx;
  color: #333;
  text-align: right;
  padding: 5rpx 0;
  border-bottom: 2rpx solid #1890ff;
}

.info-text {
  font-size: 30rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.edit-icon {
  font-size: 24rpx;
  margin-left: 10rpx;
}

.info-action {
  font-size: 30rpx;
  color: #1890ff;
}

.action-text {
  font-size: 28rpx;
}

.unbind-section {
  background-color: #fff;
  border-radius: 15rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.unbind-item {
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
}

.unbind-item:last-child {
  border-bottom: none;
}

.unbind-item text {
  font-size: 28rpx;
  color: #ff4d4f;
}

.button-section {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.cancel-btn {
  flex: 1;
  padding: 25rpx;
  background-color: #fff;
  border: 2rpx solid #e5e5e5;
  border-radius: 10rpx;
  text-align: center;
  margin-right: 20rpx;
}

.cancel-btn text {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
}

.submit-btn {
  flex: 1;
  padding: 25rpx;
  background-color: #1890ff;
  border-radius: 10rpx;
  text-align: center;
  margin-left: 20rpx;
}

.submit-btn text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}

.submit-btn.loading {
  background-color: #87ceeb;
}

.tip-section {
  padding: 0 10rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 36rpx;
}

/* Responsive design */
@media (max-width: 375px) {
  .info-label {
    font-size: 28rpx;
    width: 130rpx;
  }
  
  .info-text,
  .info-input,
  .action-text {
    font-size: 28rpx;
  }
  
  .cancel-btn text,
  .submit-btn text {
    font-size: 28rpx;
  }
}
