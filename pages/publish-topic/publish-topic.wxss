/* pages/publish-topic/publish-topic.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* Page header */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 40rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
}

.back-text {
  font-size: 28rpx;
  color: #666;
}

.header-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.header-right {
  width: 100rpx;
  text-align: right;
}

.draft-btn {
  font-size: 28rpx;
  color: #667eea;
}

/* Publish form */
.publish-form {
  padding: 30rpx;
}

.form-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.title-input {
  width: 100%;
  font-size: 32rpx;
  color: #333;
  line-height: 1.5;
}

.title-count {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  text-align: right;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.content-count {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  text-align: right;
}

/* Image upload */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-delete text {
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #fafafa;
}

.add-icon {
  font-size: 60rpx;
  color: #999;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

/* Picker */
.select-label {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 20rpx;
}

.select-label text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.required {
  color: #ff4d4f !important;
}

.select-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.select-value text {
  font-size: 28rpx;
  color: #333;
}

.placeholder {
  color: #999 !important;
}

.arrow {
  color: #999 !important;
  font-size: 36rpx;
}

/* Tag input */
.tag-input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tag-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.tag-add-btn {
  font-size: 26rpx;
  color: #667eea;
  background: none;
  border: 1rpx solid #667eea;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
}

.tag-add-btn::after {
  border: none;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #f0f7ff;
  border-radius: 24rpx;
}

.tag-text {
  font-size: 26rpx;
  color: #667eea;
}

.tag-delete {
  font-size: 32rpx;
  color: #999;
  line-height: 1;
}

/* Toggle switch */
.switch-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label-text {
  font-size: 28rpx;
  color: #333;
}

.switch {
  transform: scale(0.9);
}

/* Publish button */
.publish-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.publish-btn {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  border-radius: 50rpx;
  padding: 28rpx;
  border: none;
}

.publish-btn::after {
  border: none;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 20rpx 0;
  max-height: 600rpx;
  overflow-y: auto;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.category-item.active {
  background: #f0f7ff;
}

.category-name {
  font-size: 28rpx;
  color: #333;
}

.category-check {
  font-size: 36rpx;
  color: #667eea;
}

.modal-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  width: 100%;
  background: #667eea;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
  padding: 24rpx;
  border: none;
}

.modal-btn::after {
  border: none;
}
