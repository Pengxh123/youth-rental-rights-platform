/* pages/topic-detail/topic-detail.wxss */
/* Page header */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 40rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
}

.back-text {
  font-size: 28rpx;
  color: #666;
}

.header-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.header-right {
  width: 80rpx;
}

/* Author card */
.author-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.author-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.topic-time {
  font-size: 24rpx;
  color: #999;
}

.follow-btn {
  padding: 12rpx 24rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
}

/* Topic content */
.topic-content {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.content-title {
  display: block;
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.content-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.content-tag {
  padding: 6rpx 16rpx;
  background: #e6f7ff;
  color: #1890ff;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.content-text {
  display: block;
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 20rpx;
  white-space: pre-wrap;
}

.content-images {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.content-image {
  width: 330rpx;
  height: 330rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

/* Interaction bar */
.interaction-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.interaction-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.interaction-icon {
  font-size: 36rpx;
}

.interaction-count {
  font-size: 26rpx;
  color: #666;
}

/* Comments section */
.comments-section {
  background: #fff;
  padding: 30rpx;
  padding-bottom: 150rpx;
}

.comments-header {
  margin-bottom: 30rpx;
}

.comments-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.comment-author {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.comment-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.comment-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}

.comment-actions {
  display: flex;
  gap: 24rpx;
}

.comment-action {
  font-size: 24rpx;
  color: #999;
}

/* Bottom input bar */
.comment-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.input-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cancel-reply {
  font-size: 24rpx;
  color: #999;
}

.send-btn {
  padding: 16rpx 32rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  border: none;
}

.send-btn[disabled] {
  background: #d9d9d9;
}

/* Image detail page style */
.image-detail {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.image-container {
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.detail-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.image-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.4;
}

.image-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.image-stats {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.image-stats .stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.image-stats .stat-icon {
  font-size: 24rpx;
  color: #999;
}

.image-stats .stat-value {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}
