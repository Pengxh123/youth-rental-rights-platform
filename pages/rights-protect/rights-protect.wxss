/* pages/rights-protect/rights-protect.wxss */
.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 30rpx;
}

.function-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.function-card.apply {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
}

.function-card.tools {
  background: linear-gradient(135deg, #40a9ff 0%, #69c0ff 100%);
}

.function-card.query {
  background: linear-gradient(135deg, #69c0ff 0%, #91d5ff 100%);
}

.function-card.help {
  background: linear-gradient(135deg, #91d5ff 0%, #bae7ff 100%);
}

.function-icon {
  font-size: 56rpx;
}

.function-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

.function-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* Section title */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
}

.more-text {
  font-size: 28rpx;
  color: #1890ff;
}

/* Rights records */
.records-list {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.record-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-type {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.record-type.deposit {
  background: #fff1f0;
  color: #ff4d4f;
}

.record-type.fee {
  background: #fffbe6;
  color: #faad14;
}

.record-type.fake {
  background: #e6f7ff;
  color: #1890ff;
}

.record-type.other {
  background: #f0f0f0;
  color: #666;
}

.record-status {
  font-size: 24rpx;
  font-weight: 500;
}

.record-status.pending {
  color: #faad14;
}

.record-status.processing {
  color: #1890ff;
}

.record-status.success {
  color: #52c41a;
}

.record-status.failed {
  color: #ff4d4f;
}

.record-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.record-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-no {
  font-size: 24rpx;
  color: #999;
}

/* Empty state */
.empty-records {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 80rpx 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.empty-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 300rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  text-align: center;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Stats card */
.stats-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-bar {
  margin-bottom: 24rpx;
}

.stat-bar:last-child {
  margin-bottom: 0;
}

.stat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.stat-type {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.stat-count {
  font-size: 26rpx;
  color: #666;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s;
}

/* Process card */
.process-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.process-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.process-item:last-child {
  margin-bottom: 0;
}

.process-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.process-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 4rpx;
}

.process-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.process-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* Success cases */
.cases-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  border: none;
}

.cases-swiper {
  height: 280rpx;
  border: none;
  overflow: hidden;
}

.case-item {
  height: 240rpx;
  padding: 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: none;
  position: relative;
}

/* Adjust swiper indicator position */
.cases-swiper .wx-swiper-dots {
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
}

/* Ensure swiper has no border */
.cases-swiper .wx-swiper-item {
  border: none;
}

.cases-swiper .wx-swiper {
  border: none;
}



.case-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.case-result {
  font-size: 26rpx;
  color: #1890ff;
  font-weight: 600;
  margin-top: 4rpx;
}

.case-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.case-time {
  font-size: 22rpx;
  color: #999999;
  text-align: right;
  margin-top: 8rpx;
}

/* Legal aid */
.legal-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 10rpx 0;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.legal-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.legal-item:last-child {
  border-bottom: none;
}

.legal-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.legal-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.legal-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.legal-desc {
  font-size: 24rpx;
  color: #999;
}

.legal-arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}
