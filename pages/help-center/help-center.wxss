/* pages/help-center/help-center.wxss */
/* Search bar */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 32rpx;
  color: #999;
}

.search-input {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  background: #f5f7fa;
  border-radius: 32rpx;
  font-size: 28rpx;
}

/* Category grid */
.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 30rpx 30rpx;
}

.category-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
}

.category-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.category-count {
  font-size: 24rpx;
  color: #999;
}

/* Section title */
.section-title {
  display: block;
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

/* FAQ */
.faq-list {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.faq-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.faq-icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
}

.faq-question {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.faq-answer {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  padding-left: 64rpx;
  white-space: pre-line;
}

.faq-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-left: 64rpx;
}

.faq-views {
  font-size: 24rpx;
  color: #999;
}

.faq-arrow {
  font-size: 36rpx;
  color: #ccc;
  font-weight: 300;
}

/* Contact card */
.contact-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
}

.contact-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.contact-title {
  display: block;
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.contact-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.contact-actions {
  display: flex;
  gap: 20rpx;
}

.contact-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.contact-btn.chat {
  background: #fff;
  color: #667eea;
}

.contact-btn.phone {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 28rpx;
}

/* Help center home bottom padding */
.page-container {
  padding-bottom: 150rpx;
}

/* Guide detail page style */
.guide-detail-container {
  min-height: 100vh;
  background: #fff;
  padding-bottom: 100rpx;
}

.guide-detail-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 10;
}

.guide-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
}

.back-text {
  font-size: 28rpx;
  color: #333;
}

.guide-tag {
  margin-left: auto;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
}

.guide-detail-content {
  padding: 40rpx 30rpx;
  padding-bottom: 100rpx;
}

.guide-title {
  display: block;
  font-size: 40rpx;
  color: #333;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.guide-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 40rpx;
  padding: 24rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
}

.guide-body {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.guide-body::before {
  content: '```';
  display: block;
  margin: 20rpx 0;
}

.guide-body::after {
  content: '```';
  display: block;
  margin: 20rpx 0;
}

/* Search results */
.search-results {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.search-count {
  font-size: 24rpx;
  color: #999;
}

.search-list {
  margin-bottom: 20rpx;
}

.search-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-item:last-child {
  border-bottom: none;
}

.search-item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.search-item-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.search-footer {
  text-align: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.clear-text {
  font-size: 26rpx;
  color: #40a9ff;
}
