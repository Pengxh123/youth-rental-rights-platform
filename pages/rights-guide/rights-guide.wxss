/* pages/rights-guide/rights-guide.wxss */
page {
  background-color: #f5f5f5;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.guide-container {
  padding: 30rpx;
}

.header-card {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.header-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

.quick-nav {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
}

.nav-item {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  border-right: 1rpx solid #f0f0f0;
}

.nav-item:last-child {
  border-right: none;
}

.nav-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.nav-text {
  font-size: 24rpx;
  color: #666;
}

.guide-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.process-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.process-item {
  display: flex;
  align-items: flex-start;
}

.process-number {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.process-content {
  flex: 1;
}

.process-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.process-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  display: block;
  margin-bottom: 15rpx;
}

.process-tags {
  display: flex;
  gap: 15rpx;
}

.process-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.process-tag.important {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

.process-tag.normal {
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.process-tag.highlight {
  background: rgba(24, 144, 255, 0.1);
  color: #1890ff;
}

.process-tag.time {
  background: #f0f0f0;
  color: #999;
}

.evidence-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.evidence-item {
  padding: 25rpx;
  border-radius: 16rpx;
  border: 2rpx solid #f0f0f0;
}

.evidence-item.required {
  background: rgba(255, 77, 79, 0.05);
  border-color: #ff4d4f;
}

.evidence-item.recommended {
  background: rgba(82, 196, 26, 0.05);
  border-color: #52c41a;
}

.evidence-item.optional {
  background: #fafafa;
}

.evidence-icon {
  font-size: 50rpx;
  margin-bottom: 15rpx;
}

.evidence-content {
  position: relative;
}

.evidence-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.evidence-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.evidence-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.evidence-tag.required {
  background: #ff4d4f;
  color: #fff;
}

.evidence-tag.recommended {
  background: #52c41a;
  color: #fff;
}

.evidence-tag.optional {
  background: #999;
  color: #fff;
}

.channels-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.channel-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  background: #fafafa;
  border-radius: 16rpx;
}

.channel-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.channel-icon text {
  font-size: 50rpx;
}

.channel-content {
  flex: 1;
}

.channel-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.channel-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.channel-phone {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: bold;
}

.channel-arrow {
  font-size: 40rpx;
  color: #d9d9d9;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.faq-item {
  border-bottom: 1rpx solid #f0f0f0;
}

.faq-question {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.faq-icon {
  margin-right: 15rpx;
  color: #999;
  font-size: 20rpx;
}

.faq-q {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.faq-answer {
  padding: 0 20rpx 20rpx 50rpx;
  background: #fafafa;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.faq-a {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.tips-card {
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fa8c16;
  display: block;
  margin-bottom: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}
