/* pages/location-picker/location-picker.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* Location card */
.location-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.location-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.location-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.location-status {
  font-size: 24rpx;
  color: #999;
}

.location-display {
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.location-text {
  font-size: 28rpx;
  color: #0050b3;
  font-weight: 600;
}

/* Center button container */
.center-btn-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 20rpx;
}

.center-btn {
  width: 80% !important;
}

.location-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.location-btn.primary {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
}

.location-btn[disabled] {
  background: #d9d9d9;
  color: #fff;
}

/* Manual selection area */
.picker-section {
  margin-bottom: 32rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.picker-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999;
}

/* Popular cities */
.cities-section {
  margin-top: 32rpx;
}

.section-subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}

.city-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.city-item {
  padding: 20rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #e6f7ff 100%);
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1890ff;
  font-weight: 500;
  border: 2rpx solid #bae7ff;
  transition: all 0.3s;
}

.city-item:active {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  border-color: #1890ff;
  transform: scale(0.95);
}

/* Bottom confirm button */
.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(82, 196, 26, 0.3);
}

.confirm-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}
