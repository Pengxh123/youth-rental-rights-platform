/* pages/case-detail/case-detail.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.content-wrapper {
  padding: 30rpx;
}

/* Case card */
.case-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.case-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.case-type {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #e6f7ff;
  color: #1890ff;
}

.case-type.deposit {
  background: #fff1f0;
  color: #ff4d4f;
}

.case-type.utility {
  background: #f6ffed;
  color: #52c41a;
}

.case-type.fraud {
  background: #fff7e6;
  color: #fa8c16;
}

.case-type.contract {
  background: #f0f5ff;
  color: #722ed1;
}

.case-type.sublandlord {
  background: #fff1f0;
  color: #eb2f96;
}

.case-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.case-status.success {
  background: #f6ffed;
  color: #52c41a;
}

.case-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.case-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.case-amount-wrap {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.case-amount-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
}

.case-amount {
  font-size: 36rpx;
  font-weight: 600;
  color: #fa8c16;
}

.case-meta {
  display: flex;
  justify-content: flex-end;
}

.case-time {
  font-size: 24rpx;
  color: #999;
}

/* Process timeline */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.process-timeline {
  position: relative;
}

.process-item {
  position: relative;
  padding-left: 50rpx;
  padding-bottom: 40rpx;
}

.process-item:last-child {
  padding-bottom: 0;
}

.process-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #ddd;
}

.process-dot.completed {
  background: #52c41a;
}

.process-dot.active {
  background: #1890ff;
  box-shadow: 0 0 0 8rpx rgba(24, 144, 255, 0.2);
}

.process-line {
  position: absolute;
  left: 10rpx;
  top: 40rpx;
  width: 4rpx;
  height: calc(100% - 60rpx);
  background: #e8e8e8;
}

.process-content {
  display: flex;
  flex-direction: column;
}

.process-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.process-time {
  font-size: 24rpx;
  color: #999;
}

/* Warm tips */
.tips-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.tips-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.tips-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 24rpx;
  display: block;
}

.apply-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1890ff 0%, #69c0ff 100%);
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
