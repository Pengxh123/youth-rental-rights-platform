.search-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.search-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f0f0f0;
  border-radius: 20rpx;
  padding: 15rpx 20rpx;
  margin-right: 20rpx;
  position: relative;
  overflow: hidden;
  z-index: 1;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 15rpx;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  height: 60rpx;
  line-height: 60rpx;
  border: none;
  outline: none;
  -webkit-tap-highlight-color: transparent;
  caret-color: #1890ff;
}

.clear-icon {
  font-size: 32rpx;
  color: #999;
  margin-left: 10rpx;
  padding: 5rpx;
}

.search-btn {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
  padding: 10rpx;
}

.search-section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.section-header text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.result-count {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.clear-history {
  font-size: 24rpx;
  color: #999;
}

.keyword-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx;
}

.keyword-item {
  padding: 15rpx 25rpx;
  background-color: #fff;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
  border: 1rpx solid #e5e5e5;
}

.keyword-item.hot {
  background-color: #fff1f0;
  color: #ff4d4f;
  border-color: #ffccc7;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #f0f0f0;
  border-top: 4rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.no-results {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}

.no-results-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.no-results text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.no-results-tip {
  font-size: 24rpx;
  color: #999;
}

.search-results {
  margin-top: 35rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.result-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background-color: #ffffff;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
}

.result-item:last-child {
  border-bottom: none;
}

.topic-result {
  width: 100%;
}

.topic-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 40rpx;
}

.topic-meta {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.dot {
  margin: 0 8rpx;
}

.topic-tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  padding: 6rpx 14rpx;
  background-color: #f0f5ff;
  color: #1890ff;
  font-size: 18rpx;
  border-radius: 10rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.tool-result {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 20rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
}

.case-result {
  width: 100%;
  background-color: #ffffff;
  padding: 20rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
}

.tool-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.tool-info {
  flex: 1;
}

.tool-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.tool-desc {
  font-size: 24rpx;
  color: #666;
}

.arrow {
  font-size: 32rpx;
  color: #999;
  margin-left: 10rpx;
}

/* Case result style */
.case-result {
  width: 100%;
}

.case-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.case-tag {
  padding: 8rpx 16rpx;
  background-color: #fff1f0;
  color: #ff4d4f;
  font-size: 20rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.case-status {
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.case-status.success {
  background-color: #f6ffed;
  color: #52c41a;
}

.case-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 45rpx;
}

.case-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 36rpx;
}

.case-info {
  display: flex;
  justify-content: space-between;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.info-item {
  flex: 1;
}

.info-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 5rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

/* Responsive design */
@media (max-width: 375px) {
  .search-input {
    font-size: 26rpx;
  }
  
  .section-header text {
    font-size: 30rpx;
  }
  
  .keyword-item {
    font-size: 24rpx;
    padding: 12rpx 20rpx;
  }
  
  .topic-title {
    font-size: 28rpx;
  }
}
