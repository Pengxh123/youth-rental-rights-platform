/* pages/scenario-guide/scenario-guide.wxss */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #f5f5f5 100%);
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

/* Nav bar */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.nav-placeholder {
  width: 60rpx;
}

/* Scenario intro */
.scenario-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx 30rpx;
  background: #fff;
  margin: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.scenario-icon-large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.scenario-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.scenario-title {
  font-size: 36rpx;
  color: #333;
  font-weight: 700;
}

.scenario-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

/* Section card */
.section-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 24rpx 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

/* Tips list */
.tips-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #e6f0ff 100%);
  border-radius: 12rpx;
}

.tip-bullet {
  font-size: 32rpx;
  color: #1890ff;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* Evaluation criteria */
.criteria-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.criteria-item {
  padding: 24rpx;
  background: #fafbfc;
  border-radius: 16rpx;
  border-left: 4rpx solid #1890ff;
}

.criteria-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.criteria-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.criteria-stars {
  font-size: 28rpx;
}

.criteria-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
}

/* Recommended listings */
.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recommend-item {
  padding: 24rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #eef2f6 100%);
  border-radius: 16rpx;
  border: 1rpx solid #e0e6ed;
}

.recommend-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.recommend-type {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.recommend-price {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: 700;
}

.recommend-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recommend-area {
  font-size: 26rpx;
  color: #666;
}

.recommend-reason {
  font-size: 24rpx;
  color: #1890ff;
  background: #e6f7ff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  width: fit-content;
}

/* Bottom action bar */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.08);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}
