/* Pro bono lawyer consult page style */
.page-container {
  background: #ffffff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: 20rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* Lawyer team info */
.lawyer-info {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid #e8e8e8;
}

.lawyer-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.lawyer-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.lawyer-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.lawyer-specialty {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: 500;
}

.lawyer-desc {
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
}

/* Chat area */
.chat-container {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Message style */
.message {
  max-width: 80%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.system-message {
  align-self: center;
  background: #f0f0f0;
  border-radius: 20rpx;
}

.user-message {
  align-self: flex-end;
  background: #e6f7ff;
  border-radius: 16rpx 16rpx 4rpx 16rpx;
}

.lawyer-message {
  align-self: flex-start;
  background: #f0f0f0;
  border-radius: 4rpx 16rpx 16rpx 16rpx;
}

.system-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.message-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.user-message .message-text {
  color: #1890ff;
}

/* Chat content area */
.chat-messages {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Bottom area container */
.bottom-container {
  position: fixed;
  bottom: 15rpx; /* ~4mm */
  left: 0;
  right: 0;
  z-index: 50;
  width: 100%;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 0;
}

/* Input area */
.input-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  background: #ffffff;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f8f9fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #333;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #1890ff;
  color: #ffffff;
  border: none;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  padding: 0;
}

.send-btn:disabled {
  background: #d9d9d9;
  color: #ffffff;
}

/* Bottom tips */
.bottom-tip {
  padding: 16rpx 20rpx;
  background: #fffbe6;
  border-top: 1rpx solid #ffe58f;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  flex-shrink: 0;
  margin-top: 0;
}

.tip-text {
  font-size: 22rpx;
  color: #fa8c16;
  line-height: 1.4;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Scrollbar style */
.chat-container::-webkit-scrollbar {
  width: 4rpx;
}

.chat-container::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 2rpx;
}

.chat-container::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 2rpx;
}

.chat-container::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}