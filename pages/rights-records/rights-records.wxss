/* pages/rights-records/rights-records.wxss */
page {
  background-color: #f5f5f5;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.records-container {
  padding: 30rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.record-type {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.record-type.deposit {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

.record-type.fee {
  background: rgba(250, 173, 20, 0.1);
  color: #faad14;
}

.record-type.fake {
  background: rgba(24, 144, 255, 0.1);
  color: #1890ff;
}

.record-type.breach {
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.record-type.other {
  background: rgba(114, 46, 209, 0.1);
  color: #722ed1;
}

.type-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.type-text {
  font-size: 24rpx;
  font-weight: bold;
}

.record-status {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.record-status.pending {
  color: #faad14;
}

.record-status.processing {
  color: #1890ff;
}

.record-status.completed {
  color: #52c41a;
}

.record-status.rejected {
  color: #ff4d4f;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.record-status.pending .status-dot,
.record-status.rejected .status-dot {
  background: #faad14;
}

.record-status.processing .status-dot {
  background: #1890ff;
}

.record-status.completed .status-dot {
  background: #52c41a;
}

.record-content {
  margin-bottom: 20rpx;
}

.record-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.record-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.record-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 15rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.info-icon {
  margin-right: 10rpx;
}

.progress-section {
  padding: 20rpx 0;
  margin-top: 10rpx;
}

.progress-title {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.progress-track {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #52c41a 0%, #73d13d 100%);
  border-radius: 8rpx;
}

.progress-percent {
  float: right;
  font-size: 24rpx;
  color: #52c41a;
  font-weight: bold;
}

.empty-records {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 300rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
}
