/* pages/fee-check/fee-check.wxss */
.function-tabs {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0;
  background: #f5f7fa;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
}

.tab-icon {
  font-size: 40rpx;
}

.tab-text {
  font-size: 24rpx;
  color: #666;
}

.tab-item.active .tab-text {
  color: #fff;
  font-weight: 500;
}

.tab-content {
  padding: 0 30rpx;
}

/* Form style */
.verify-form,
.calculator-form {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-view {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

.verify-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 20rpx;
}

/* Verify result */
.verify-result,
.rent-result,
.calculator-result {
  margin-top: 30rpx;
}

.result-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 30rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.result-header.success {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.result-header.warning {
  background: linear-gradient(135deg, #faad14 0%, #d48806 100%);
}

.result-icon {
  font-size: 48rpx;
}

.result-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

.result-details {
  background: #fff;
  padding: 0 30rpx 30rpx;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-label {
  font-size: 28rpx;
  color: #666;
}

.result-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.result-item.overpriced .result-value {
  color: #ff4d4f;
}

/* Negotiation script card */
.negotiation-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx 0;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.card-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.copy-btn {
  width: 200rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
  border: none;
}

.report-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

/* Price analysis */
.analysis-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.analysis-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.analysis-label {
  font-size: 26rpx;
  color: #666;
  width: 180rpx;
}

.price-bar {
  flex: 1;
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.5s;
}

.analysis-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  width: 100rpx;
  text-align: right;
}

.analysis-text {
  display: block;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.analysis-text text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* Calculator result */
.result-tabs {
  display: flex;
  gap: 20rpx;
  margin: 30rpx 0 20rpx;
}

.result-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: #f5f7fa;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}

.result-tab.active {
  background: #1890ff;
  color: #fff;
}

.total-card {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(24, 144, 255, 0.3);
}

.total-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
}

.total-value {
  display: block;
  font-size: 56rpx;
  color: #fff;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.total-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* Fee breakdown */
.breakdown-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.breakdown-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.breakdown-item:last-child,
.breakdown-item.total {
  border-bottom: none;
}

.breakdown-item.total {
  padding-top: 20rpx;
  margin-top: 10rpx;
  border-top: 2rpx solid #1890ff;
}

.breakdown-label {
  font-size: 28rpx;
  color: #666;
}

.breakdown-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.breakdown-item.total .breakdown-value {
  font-size: 36rpx;
  color: #1890ff;
}

/* Pie chart */
.pie-chart {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pie-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pie-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
}

.pie-label {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.pie-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}
