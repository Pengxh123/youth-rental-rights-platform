.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* Location selection area */
.location-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.location-header {
  margin-bottom: 16rpx;
}

.location-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.location-info {
  margin-bottom: 16rpx;
}

.location-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.location-placeholder {
  color: #999;
}

.location-button {
  background-color: #1890ff;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  width: 100%;
  margin-top: 8rpx;
}

.location-button:hover {
  background-color: #40a9ff;
}

/* Common card style */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

/* Basic data area */
.data-section {
  margin-bottom: 20rpx;
}

.base-price-card {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
  padding: 20rpx;
  background-color: #f0f5ff;
  border-radius: 12rpx;
}

.base-price-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 12rpx;
}

.base-price-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
  margin-right: 8rpx;
}

.base-price-unit {
  font-size: 24rpx;
  color: #666;
}

.market-trend {
  margin-top: 16rpx;
}

.trend-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 8rpx;
}

.trend-text {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

/* Layout price area */
.housing-section {
  margin-bottom: 20rpx;
}

.housing-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.housing-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  border-left: 4rpx solid #1890ff;
}

.housing-info {
  flex: 1;
}

.housing-type {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.housing-area {
  font-size: 22rpx;
  color: #666;
}

.housing-price {
  text-align: right;
}

.price-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff4d4f;
  display: block;
  margin-bottom: 4rpx;
}

.price-trend {
  font-size: 20rpx;
  color: #999;
}

/* Utility price area */
.utility-section {
  margin-bottom: 20rpx;
}

.utility-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.utility-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background-color: #f6ffed;
  border-radius: 12rpx;
  border-left: 4rpx solid #52c41a;
}

.utility-type {
  font-size: 26rpx;
  color: #333;
}

.utility-price {
  font-size: 26rpx;
  font-weight: 500;
  color: #52c41a;
}

/* Tips area */
.tips-section {
  margin-bottom: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.tip-bullet {
  font-size: 24rpx;
  font-weight: bold;
  color: #1890ff;
  min-width: 32rpx;
}

.tip-content {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  line-height: 1.4;
}

/* Platform area */
.platform-section {
  margin-bottom: 20rpx;
}

.recommend-notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background-color: #fff7e6;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  border-left: 4rpx solid #faad14;
}

.notice-icon {
  font-size: 32rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.platform-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.platform-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  transition: all 0.3s;
}

.platform-card:hover {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transform: translateY(-2rpx);
}

.platform-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.platform-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.platform-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background-color: #e6f7ff;
  color: #1890ff;
}

.platform-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.platform-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.platform-label {
  font-size: 20rpx;
  color: #999;
}

.platform-arrow {
  font-size: 32rpx;
  color: #999;
}

/* Loading state */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* Empty state */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 20rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 32rpx;
  line-height: 1.4;
}

.empty-button {
  background-color: #1890ff;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
}

.empty-button:hover {
  background-color: #40a9ff;
}

/* Picker style */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
}

.picker-content {
  background-color: #fff;
  border-radius: 16rpx 16rpx 0 0;
  width: 100%;
  max-height: 70vh;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.picker-close {
  font-size: 40rpx;
  color: #999;
  cursor: pointer;
}

.picker-list {
  max-height: 60vh;
  padding: 0 24rpx 24rpx;
  overflow-y: auto;
}

.picker-empty {
  padding: 48rpx 0;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

.picker-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-item-text {
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.picker-item:active {
  background-color: #f5f5f5;
}

/* Responsive design */
@media (max-width: 375px) {
  .container {
    padding: 16rpx;
  }
  
  .location-section,
  .card {
    padding: 20rpx;
  }
  
  .location-title,
  .section-title {
    font-size: 28rpx;
  }
  
  .base-price-value {
    font-size: 40rpx;
  }
}

/* New province/city picker window style */
.city-selector-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10rpx);
}

.modal-content {
  position: relative;
  background-color: #fff;
  border-radius: 24rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 40rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.modal-close:active {
  background-color: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
}

.section-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.province-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.province-item {
  padding: 24rpx 16rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8eb 100%);
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.3s ease;
  cursor: pointer;
  border: 2rpx solid transparent;
}

.province-item:active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.province-item:active .province-text {
  color: #fff;
}

.province-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  transition: color 0.3s ease;
}

.city-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.city-item {
  padding: 28rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.3s ease;
  cursor: pointer;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
}

.city-item:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.city-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.selected-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.selected-label {
  font-size: 26rpx;
  color: #999;
}

.selected-value {
  font-size: 28rpx;
  color: #667eea;
  font-weight: bold;
}

.back-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.back-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}
