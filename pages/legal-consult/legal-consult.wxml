<!-- Pro Bono Lawyer Consultation Page -->
<view class="page-container">
  <!-- Top Nav Bar -->
  <view class="custom-navbar">
    <text class="nav-title">Pro Bono Legal Consultation</text>
  </view>

<!-- Scam Prevention Tips Popup -->
<view class="tips-modal" wx:if="{{showTipsModal}}" bindtap="hideTips">
  <view class="tips-content" catchtap="catchTouch">
    <text class="tips-title">Rental Scam Prevention Tips</text>
    <view class="tips-close" bindtap="hideTips">×</view>
    <view wx:for="{{tipsData}}" wx:key="title" class="tips-item">
      <text class="tips-item-title">{{item.title}}</text>
      <text class="tips-item-content">{{item.content}}</text>
    </view>
  </view>
</view>

  <!-- Lawyer Team Info -->
  <view class="lawyer-info">
    <view class="lawyer-avatar">
      <image src="/images/lawyer-avatar.png" mode="aspectFill"></image>
    </view>

<!-- Scam Prevention Tips Popup -->
<view class="tips-modal" wx:if="{{showTipsModal}}" bindtap="hideTips">
  <view class="tips-content" catchtap="catchTouch">
    <text class="tips-title">Rental Scam Prevention Tips</text>
    <view class="tips-close" bindtap="hideTips">×</view>
