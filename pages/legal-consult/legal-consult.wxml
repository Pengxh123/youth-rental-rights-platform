      <text class="tips-item-title">{{item.title}}</text>
      <text class="tips-item-content">{{item.content}}</text>
    </view>
  </view>
</view>
    <view class="lawyer-details">
      <text class="lawyer-name">Pro Bono Legal Team</text>
      <text class="lawyer-specialty">Rental Rights Professional Consultation</text>
      <text class="lawyer-description">Free legal consultation, protecting youth rental rights</text>
    </view>

