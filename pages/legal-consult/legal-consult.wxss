/* Pro bono lawyer consult page style */
.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Top nav bar */
.custom-navbar {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.05);
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* Lawyer team info */
.lawyer-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.lawyer-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lawyer-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lawyer-details {
  flex: 1;
}

.lawyer-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.lawyer-specialty {
  font-size: 24rpx;
  color: #40a9ff;
  margin-top: 4rpx;
}

.lawyer-description {
  font-size: 22rpx;
  color: #666;
  margin-top: 6rpx;
}

/* Chat container */
.chat-container {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.message {
  max-width: 80%;
  display: flex;
  flex-direction: column;
}

.message-content {
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  position: relative;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.message-time {
  font-size: 20rpx;
  color: #999;
  text-align: right;
  margin-top: 8rpx;
}

/* Lawyer message style */
.lawyer-message {
  align-self: flex-start;
}

.lawyer-message .message-content {
  background: #ffffff;
  border: 1rpx solid #e6f7ff;
  color: #333;
}

/* User message style */
.user-message {
  align-self: flex-end;
  align-items: flex-end;
}

.user-message .message-content {
  background: linear-gradient(135deg, #40a9ff 0%, #69c0ff 100%);
  color: #fff;
  margin-left: auto;
}

/* Input area */
.input-container {
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  padding: 20rpx 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
  position: relative;
  z-index: 100;
}

.input-box {
  flex: 1;
  height: 72rpx;
  background: #f8f9fa;
  border: 1rpx solid #f0f0f0;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  line-height: 72rpx;
  color: #333;
  -webkit-tap-highlight-color: transparent;
  caret-color: #40a9ff;
  outline: none;
  border: 1px solid #e6e6e6;
}

.send-btn {
  width: 100rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #40a9ff 0%, #69c0ff 100%);
  font-size: 28rpx;
  color: #fff;
  padding: 0 20rpx;
  border: none;
  outline: none;
  -webkit-tap-highlight-color: transparent;
}

/* Bottom tips area */
.disclaimer-container {
  background: #fff9e6;
  border-top: 1rpx solid #ffd700;
  padding: 12rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  cursor: pointer;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #ff6b00;
  line-height: 1.4;
  text-align: center;
}

.tips-text {
  font-size: 22rpx;
  color: #666;
  text-align: center;
}

.disclaimer-container:active {
  background: #fff0d6;
}

/* Scam prevention tips popup */
.tips-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.tips-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  max-width: 80%;
  width: 600rpx;
  max-height: 70vh;
  overflow-y: auto;
  position: relative;
}

.tips-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.tips-close {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.tips-item {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}

.tips-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.tips-item-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* Loading state style */
.loading-container {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.loading-spinner {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

.loading-spinner::before {
  content: '';
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #40a9ff;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

