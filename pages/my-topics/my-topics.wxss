/* pages/my-topics/my-topics.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* Topic list area */
.topics-section {
  margin-top: 20rpx;
}

.section-header {
  padding: 20rpx 30rpx;
  background: #f5f5f5;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* Topic list */
.topics-list {
  padding: 0;
  background: #fff;
}

/* Topic item */
.topic-item {
  background: #fff;
  border-radius: 0;
  padding: 30rpx;
  margin-bottom: 0;
  box-shadow: none;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.topic-item:active {
  background: #f9f9f9;
  transform: none;
  box-shadow: none;
}

/* Topic header */
.topic-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* Topic title */
.topic-title {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-right: 20rpx;
  line-height: 1.4;
}

/* Topic content */
.topic-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* Topic stats */
.topic-stats {
  display: flex;
  align-items: center;
  gap: 30rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 28rpx;
}

.stat-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* Topic time */
.topic-time {
  font-size: 24rpx;
  color: #999;
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 30rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
  text-align: center;
}

.empty-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 28rpx;
  border: none;
}

.empty-btn::after {
  border: none;
}

/* Floating button */
.fab-button {
  position: fixed;
  bottom: 100rpx;
  right: 30rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  z-index: 999;
}

.fab-icon {
  font-size: 60rpx;
  color: #fff;
  font-weight: 300;
}
