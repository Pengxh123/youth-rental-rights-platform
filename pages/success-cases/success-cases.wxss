/* pages/success-cases/success-cases.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 100rpx;
}

/* Page header */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.header-left {
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.header-right {
  display: flex;
  align-items: center;
}

.search-icon {
  font-size: 32rpx;
}

/* Filter tags */
.filter-section {
  background: #fff;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.filter-scroll {
  display: flex;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-item {
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.filter-item.active {
  background: #40a9ff;
  color: #fff;
}

.filter-item:last-child {
  margin-right: 0;
}

/* Case list */
.cases-section {
  padding: 20rpx;
}

.case-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.case-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

/* Case header */
.case-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.case-tag {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.case-tag.deposit {
  background: #f0f9ff;
  color: #40a9ff;
}

.case-tag.utility {
  background: #f0f9ff;
  color: #40a9ff;
}

.case-tag.contract {
  background: #f0f9ff;
  color: #40a9ff;
}

.case-tag.sublandlord {
  background: #f0f9ff;
  color: #40a9ff;
}

.case-tag.fraud {
  background: #f0f9ff;
  color: #40a9ff;
}

.case-status {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.case-status.success {
  background: #f0f9ff;
  color: #40a9ff;
}

.case-status.failed {
  background: #fff2f0;
  color: #ff4d4f;
}

/* Case title and description */
.case-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.case-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* Case info */
.case-info {
  display: flex;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.info-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* Process flow */
.case-process {
  margin-bottom: 20rpx;
}

.process-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.process-timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 24rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -40rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background: #40a9ff;
  border-radius: 50%;
}

.timeline-content {
  display: flex;
  flex-direction: column;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: #999;
}

/* Case footer */
.case-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.footer-stats {
  display: flex;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-left: 30rpx;
}

.stat-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.stat-text {
  font-size: 28rpx;
  color: #666;
}