.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #fff8d6;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 10rpx rgba(255, 193, 7, 0.05);
  z-index: 1000;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
  gap: 6rpx;
  transition: all 0.3s;
  position: relative;
}

.nav-icon {
  font-size: 48rpx;
  line-height: 1;
  opacity: 0.5;
}

.nav-text {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.2;
}

.nav-item.active .nav-icon {
  opacity: 1;
  transform: scale(1.1);
}

.nav-item.active .nav-text {
  color: #ffc107;
  font-weight: 500;
}

.nav-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #ffc107;
  border-radius: 2rpx;
}
